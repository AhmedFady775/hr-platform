# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# SQL Server
MSSQL_SA_PASSWORD=
MSSQL_PID=Developer
DB_NAME=HrPlatformDb
SQLSERVER_PORT=1433

# Redis
REDIS_PORT=6379

# JWT (Api)
JWT_KEY=
JWT_ISSUER=HrPlatform.Api
JWT_AUDIENCE=HrPlatform.Client
JWT_EXPIRY_MINUTES=60

# Third-party employee data source
EMPLOYEE_API_BASE_URL=https://dummyjson.com/

# Where the Web app is reachable from a browser -- used for the Api's CORS allow-list
WEB_PUBLIC_URL=http://localhost:8091

# Host ports
API_PORT=8090
WEB_PORT=8091

# ASPNETCORE_ENVIRONMENT for both Api and Web containers
ASPNETCORE_ENVIRONMENT=Development
