<nav class="side-nav">
    <NavLink class="side-nav__link" href="" Match="NavLinkMatch.All">
        <span class="side-nav__icon">🏠</span> Dashboard
    </NavLink>
    <NavLink class="side-nav__link" href="leave-requests">
        <span class="side-nav__icon">🗓️</span> Leave Requests
    </NavLink>

    <div class="side-nav__section">Coming soon</div>
    @foreach (var module in ComingSoonModules)
    {
        <span class="side-nav__link side-nav__link--disabled" title="Not built yet">
            <span class="side-nav__icon">@module.Icon</span> @module.Name
            <span class="side-nav__soon">Soon</span>
        </span>
    }
</nav>

@code {
    private static readonly (string Icon, string Name)[] ComingSoonModules =
    {
        ("💰", "Payroll"),
        ("🧑‍💼", "Onboarding"),
        ("⏱️", "Time Tracking")
    };
}
